# Operator-owned per-profile state survives plugin updates.
# Standard dotfile-pattern convention: code is git-managed; .local/ is not.
.local/

# Python build + tooling artifacts.
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# build artifacts
dist/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
